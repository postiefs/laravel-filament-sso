{
    "name": "postiefs/laravel-filament-sso",
    "description": "Filament panel plugin for the Postiefs SSO portal: a Microsoft 365 sign-in button next to the local login, portal-controlled sessions and sign-out to the launchpad.",
    "keywords": [
        "laravel",
        "filament",
        "sso",
        "entra-id",
        "microsoft-365",
        "postiefs"
    ],
    "type": "library",
    "homepage": "https://github.com/postiefs/laravel-filament-sso",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.0|^4.0|^5.0",
        "postiefs/laravel-sso": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/postiefs/laravel-sso"
        }
    ],
    "autoload": {
        "psr-4": {
            "Postiefs\\SsoFilament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Postiefs\\SsoFilament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Postiefs\\SsoFilament\\SsoFilamentServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
